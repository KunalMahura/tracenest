{
  "info": {
    "name": "TraceNest API",
    "description": "Comprehensive Postman collection for TraceNest log and performance monitoring platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "apiKey", "value": "tn_4233af265068abcd1cf88e0c8c027db8cb7a292926c3f7df" },
    { "key": "projectId", "value": "6adcf5799759bc500c5d74ca" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@tracenest.dev\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@tracenest.dev\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"College Results App\",\n  \"description\": \"Demo student results application\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "Regenerate API Key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/regenerate-key", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "regenerate-key"] }
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Ingest Single Log",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level\": \"error\",\n  \"message\": \"Database connection timeout\",\n  \"endpoint\": \"/results/101\",\n  \"method\": \"GET\",\n  \"statusCode\": 500,\n  \"durationMs\": 1240.5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ingest", "host": ["{{baseUrl}}"], "path": ["api", "ingest"] }
          }
        },
        {
          "name": "Ingest Batch of Logs",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"level\": \"info\",\n    \"message\": \"Student record fetched\",\n    \"endpoint\": \"/api/students\",\n    \"method\": \"GET\",\n    \"statusCode\": 200,\n    \"durationMs\": 45.2\n  },\n  {\n    \"level\": \"warn\",\n    \"message\": \"Slow database query detected\",\n    \"endpoint\": \"/results/500\",\n    \"method\": \"GET\",\n    \"statusCode\": 200,\n    \"durationMs\": 480.1\n  }\n]"
            },
            "url": { "raw": "{{baseUrl}}/api/ingest/batch", "host": ["{{baseUrl}}"], "path": ["api", "ingest", "batch"] }
          }
        }
      ]
    },
    {
      "name": "Analytics & Logs",
      "item": [
        {
          "name": "Overview Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/analytics/overview?projectId={{projectId}}&range=1h", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "overview"], "query": [{ "key": "projectId", "value": "{{projectId}}" }, { "key": "range", "value": "1h" }] }
          }
        },
        {
          "name": "Throughput Time-Series",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/analytics/throughput?projectId={{projectId}}&range=1h", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "throughput"], "query": [{ "key": "projectId", "value": "{{projectId}}" }, { "key": "range", "value": "1h" }] }
          }
        },
        {
          "name": "Top Slowest Endpoints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/analytics/top-endpoints?projectId={{projectId}}&range=1h", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "top-endpoints"], "query": [{ "key": "projectId", "value": "{{projectId}}" }, { "key": "range", "value": "1h" }] }
          }
        },
        {
          "name": "Top Failing Endpoints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/analytics/top-failing?projectId={{projectId}}&range=1h", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "top-failing"], "query": [{ "key": "projectId", "value": "{{projectId}}" }, { "key": "range", "value": "1h" }] }
          }
        },
        {
          "name": "Search Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/logs?projectId={{projectId}}&range=1h&limit=50", "host": ["{{baseUrl}}"], "path": ["api", "logs"], "query": [{ "key": "projectId", "value": "{{projectId}}" }, { "key": "range", "value": "1h" }, { "key": "limit", "value": "50" }] }
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "Create Alert Rule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"High Error Rate (>5%)\",\n  \"conditionType\": \"error_rate\",\n  \"threshold\": 5,\n  \"windowMinutes\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/alerts/rules", "host": ["{{baseUrl}}"], "path": ["api", "alerts", "rules"] }
          }
        },
        {
          "name": "List Alert Rules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/alerts/rules?projectId={{projectId}}", "host": ["{{baseUrl}}"], "path": ["api", "alerts", "rules"], "query": [{ "key": "projectId", "value": "{{projectId}}" }] }
          }
        },
        {
          "name": "List Triggered Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/alerts?projectId={{projectId}}", "host": ["{{baseUrl}}"], "path": ["api", "alerts"], "query": [{ "key": "projectId", "value": "{{projectId}}" }] }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    }
  ]
}
