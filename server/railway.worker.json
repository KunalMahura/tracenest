{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "package.json", "package-lock.json", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "node src/workers/logWorker.js",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
