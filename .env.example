# ── Server ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────
# Use "mongo" as host when running inside Docker
MONGO_URI=mongodb://mongo:27017/tracenest

# ── Redis ─────────────────────────────────────────────────────────────
# Use "redis" as host when running inside Docker
REDIS_HOST=redis
REDIS_PORT=6379
# Or a single connection string (takes precedence over HOST/PORT):
# REDIS_URL=redis://default:password@host:6379

# ── CORS (production) ─────────────────────────────────────────────────
# DASHBOARD_URL=https://your-dashboard.vercel.app
# ALLOWED_ORIGINS=

# ── Quotas ────────────────────────────────────────────────────────────
DEFAULT_DAILY_LOG_QUOTA=10000
MAX_PROJECTS_PER_USER=5

# ── JWT ───────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Log Retention ────────────────────────────────────────────────────
# Logs older than this many days are automatically deleted (TTL index)
LOG_TTL_DAYS=30

# ── Worker Settings ──────────────────────────────────────────────────
# How many logs to insertMany at once
WORKER_BATCH_SIZE=100
# How many BullMQ jobs to process in parallel
WORKER_CONCURRENCY=5

# ── Alerts ───────────────────────────────────────────────────────────
# Optional: HTTP/HTTPS URL to POST alert payloads to (e.g. Slack webhook)
ALERT_WEBHOOK_URL=

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
