# ═══════════════════════════════════════════════════════════════════════
#  TraceNest — production environment template
#
#  Railway:  paste these into the API service AND the worker service
#            (Variables → Raw Editor). Railway's Redis plugin provides
#            REDIS_URL — reference it as ${{Redis.REDIS_URL}}.
#  Vercel:   only VITE_API_URL is needed (dashboard project).
#  Docker:   cp .env.production.example .env.production, fill in, then
#            docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
#  Never commit the filled-in file (.env.production is git-ignored).
# ═══════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=production
# Railway injects PORT automatically — leave unset there.
# PORT=3000

# ── MongoDB Atlas (REQUIRED) ────────────────────────────────────────────
# Atlas → Connect → Drivers. Include the database name (/tracenest).
# Atlas Network Access must allow your host (0.0.0.0/0 for Railway,
# since Railway has no static egress IP on the free plans).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tracenest?retryWrites=true&w=majority

# ── Redis (REQUIRED — one of the two forms) ─────────────────────────────
# Single connection string (Railway, Render, Upstash). Use rediss:// for TLS.
REDIS_URL=redis://default:<password>@<host>:6379
# …or host/port/password (used when REDIS_URL is empty)
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# docker-compose.prod.yml only: password for the bundled Redis container
# (it builds REDIS_URL from this itself).
REDIS_PASSWORD=change_me_long_random_string

# ── Auth (REQUIRED) ─────────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS (REQUIRED for the dashboard to work) ───────────────────────────
# Public URL of the dashboard, no trailing slash.
DASHBOARD_URL=https://your-dashboard.vercel.app
# Optional extra origins allowed to call the dashboard/management API
# (comma-separated, e.g. a custom domain). The ingest API (/api/ingest/*)
# accepts every origin regardless — customers' apps authenticate with X-API-Key.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the API (Railway/Render = 1).
# Lets rate limiting see real client IPs.
TRUST_PROXY=1

# ── Quotas & limits ─────────────────────────────────────────────────────
# Logs each project may ingest per UTC day (new projects get this value).
DEFAULT_DAILY_LOG_QUOTA=10000
# Projects each account may create.
MAX_PROJECTS_PER_USER=5

# ── Retention ───────────────────────────────────────────────────────────
# Days before logs are deleted by MongoDB's TTL index.
# Atlas M0 (free) has 512 MB — keep this low for a public instance.
LOG_TTL_DAYS=7

# ── Worker tuning ───────────────────────────────────────────────────────
WORKER_BATCH_SIZE=100
WORKER_CONCURRENCY=5

# ── Alerts (optional) ───────────────────────────────────────────────────
# HTTPS URL that receives alert payloads (e.g. a Slack incoming webhook)
ALERT_WEBHOOK_URL=

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
# How long (ms) the API/worker wait for MongoDB + Redis at boot before exiting
STARTUP_TIMEOUT_MS=15000

# ═══════════════════════════════════════════════════════════════════════
#  Dashboard (Vercel project env, or docker-compose.prod.yml build arg)
# ═══════════════════════════════════════════════════════════════════════
# Public URL of the API, no trailing slash. Baked in at build time —
# redeploy the dashboard after changing it.
VITE_API_URL=https://your-api.up.railway.app

# docker-compose.prod.yml host ports
API_PORT=3000
DASHBOARD_PORT=8080
